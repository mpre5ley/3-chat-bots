# Copy to `.env` and fill in. .env is gitignored.

# Required.
SECRET_KEY=change-me-to-a-random-50-char-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Without a token, the app runs in DEMO MODE with canned responses.
HUGGING_FACE_API_TOKEN=

# Optional. Defaults to false (production posture). Set to true only for local dev.
DEBUG=true

# Optional. Defaults to SQLite at app/data/db.sqlite3.
# To use Postgres: install `psycopg[binary]>=3.2` and set:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
